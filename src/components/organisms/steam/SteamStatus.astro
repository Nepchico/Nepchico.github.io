---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSteamGameOverrides } from "@utils/steam-games";
import stylus from "stylus";
import {
	resolveSteamStatusOptions,
	steamStatusConfig,
} from "@/config/steamStatusConfig";
import SteamStatusClient from "./SteamStatusClient.svelte";
import { steamStatusStylus } from "./steamStatusStyles";

interface Props {
	class?: string;
	style?: string;
}

const options = resolveSteamStatusOptions(steamStatusConfig);
const gameOverrides = options ? await getSteamGameOverrides() : {};

const styles = options
	? await new Promise<string>((resolve, reject) => {
			stylus.render(steamStatusStylus, (error, css) => {
				if (error) reject(error);
				else resolve(css);
			});
		})
	: null;
const labels = {
	title: i18n(I18nKey.steamStatusTitle),
	loading: i18n(I18nKey.steamStatusLoading),
	unavailable: i18n(I18nKey.steamStatusUnavailable),
	statuses: {
		"in-game": i18n(I18nKey.steamStatusInGame),
		online: i18n(I18nKey.steamStatusOnline),
		offline: i18n(I18nKey.steamStatusOffline),
		error: i18n(I18nKey.steamStatusError),
	},
};
---

{options && (
	<>
		<style is:inline set:html={styles}></style>
		<SteamStatusClient client:visible {options} {gameOverrides} {labels} class={Astro.props.class} style={Astro.props.style} />
	</>
)}
